# Everything the image pins, in one place. Sourced by bash scripts and read
# by the GitHub Actions workflow, so keep it to plain NAME=value lines.

# pi-gen, arm64 branch (Debian trixie), commit of 2026-11-06.
PI_GEN_REPO=https://github.com/RPi-Distro/pi-gen.git
PI_GEN_REF=c0d2c9f2cffc08bc56850b0a3eb23178f4226e8a

# usb-proxy .deb: GitHub release v<version>, asset usb-proxy_<version>_arm64.deb
USB_PROXY_REPO=sidhantgoel/usb-proxy
USB_PROXY_VERSION=0.1.0

# Web UI .deb: GitHub release v<version>, asset midwire-web-ui_<version>_all.deb
# midwire-base needs 0.2.0 or later (the first with the Updates page).
MIDWIRE_WEB_UI_REPO=sidhantgoel/midwire-web-ui
MIDWIRE_WEB_UI_VERSION=0.4.1

# raw_gadget kernel module source, built into raw-gadget-dkms by this repo.
# The commit is the last change to the module itself (2025-12-13).
RAW_GADGET_REPO=https://github.com/xairy/raw-gadget.git
RAW_GADGET_COMMIT=fac15ca2c08ac913e434c5154a998adedb847159
RAW_GADGET_DKMS_VERSION=2025.12.13+midwire1

# midwire-base, built from midwire-base/ in this repo: the apt source, the
# updater and system configuration. Must match midwire-base/debian/changelog.
MIDWIRE_BASE_VERSION=0.4.2
