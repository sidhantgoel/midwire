// The web UI's service user may start an update check and an update
// installation. Only "start", and only these two units: what they run is
// fixed (see /usr/lib/midwire/update), so the web UI cannot choose packages
// or commands.
polkit.addRule(function(action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "midwire-web-ui")
		return polkit.Result.NOT_HANDLED;
	var unit = action.lookup("unit");
	if ((unit == "midwire-update-check.service" || unit == "midwire-update-install.service") &&
	    action.lookup("verb") == "start")
		return polkit.Result.YES;
	return polkit.Result.NOT_HANDLED;
});
