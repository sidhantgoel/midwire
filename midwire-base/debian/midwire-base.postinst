#!/bin/sh
set -e

if [ "$1" = configure ]; then
	# Apply the rule for network interfaces on USB devices to what is
	# plugged in now, not only after the next boot or re-plug.
	if [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload || true
		udevadm trigger --action=change --subsystem-match=net --property-match=ID_BUS=usb || true
	fi
fi

#DEBHELPER#

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	# So the Updates page has something to show straight away. During an
	# update the updater is already running and this exits at once.
	systemctl start --no-block midwire-update-check.service || true

	# The network link over the USB-C port: bring it up now if it is switched
	# on, unless the proxy is using the port. Restart, not start: an earlier
	# version may have left it half-up, and this is how a fix reaches it.
	if systemctl is-enabled --quiet midwire-net-gadget.service 2>/dev/null \
		&& ! systemctl is-active --quiet usb-proxy.service; then
		systemctl reset-failed midwire-net-gadget.service 2>/dev/null || true
		systemctl restart --no-block midwire-net-gadget.service || true
	fi
fi
